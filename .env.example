# ============================================================
# UNIVERSAL ADAPTIVE LEARNING PLATFORM (EDUIA)
# ENVIRONMENT CONFIGURATION SPECIFICATION (.env.example)
# ============================================================

# OpenRouter AI Gateway Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# S7.7 Astra-First AI Orchestrator (§S7.5, §S7.7)
# Strategic Primary Model: Astra is the primary high-capability model for EDUIA reasoning tasks.
EDUIA_PRIMARY_MODEL=openai/gpt-6-astra

# Operational Fallback Model: Used ONLY on operational errors (timeout, 5xx, 429, 404). NEVER redefines strategic default.
FALLBACK_MODEL=openai/gpt-4o-mini
ENABLE_OPERATIONAL_FALLBACK=true

# Task-Specific Model Registry (§29, §S7.5, §S7.7)
# Leave cognitive tasks unset to inherit EDUIA_PRIMARY_MODEL (Astra):
# TUTOR_MODEL=
# FEYNMAN_MODEL=
# DIAGNOSTIC_MODEL=
# PLAN_MODEL=
# COMPETENCY_MODEL=
# ASSESSMENT_MODEL=
# Low-risk tasks where cheaper model is policy-approved:
CLASSIFIER_MODEL=openai/gpt-4o-mini
# MATERIAL_MODEL=

# AI Gateway Operational Configuration (§28, §29)
AI_PROVIDER=openrouter
AI_TEMPERATURE=0.2
AI_MAX_RETRIES=2
AI_TIMEOUT_MS=30000

# S7.8 AI Cache + Supabase pgvector Configuration (§S7.8)
ENABLE_AI_CACHE=true
ENABLE_SEMANTIC_CACHE=true
EMBEDDING_MODEL=openai/text-embedding-3-small

# Supabase PostgreSQL & Auth Configuration (§36, §38)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Observability (§41)
SENTRY_DSN=https://your-dsn@sentry.io/project-id

# Asynchronous Background Processing (§24)
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here
