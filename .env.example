# ============================================================
# UNIVERSAL ADAPTIVE LEARNING PLATFORM (EDUIA)
# ENVIRONMENT CONFIGURATION SPECIFICATION (.env.example)
# ============================================================

# OpenRouter AI Gateway Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# S7.5 AI Model Orchestrator (§S7.5)
# DEFAULT_MODEL acts as the platform default candidate (Astra candidate when available).
# Task-specific variables override DEFAULT_MODEL. If a task model is unset, DEFAULT_MODEL is used.
DEFAULT_MODEL=
FALLBACK_MODEL=openai/gpt-4o-mini
ENABLE_OPERATIONAL_FALLBACK=true

# Task-Specific Model Registry (§29, §S7.5)
# Task-specific overrides (leave unset to inherit DEFAULT_MODEL):
TUTOR_MODEL=anthropic/claude-3.5-sonnet
FEYNMAN_MODEL=anthropic/claude-3.5-sonnet
CLASSIFIER_MODEL=openai/gpt-4o-mini
DIAGNOSTIC_MODEL=openai/gpt-4o-mini
PLAN_MODEL=anthropic/claude-3.5-sonnet
COMPETENCY_MODEL=anthropic/claude-3.5-sonnet
ASSESSMENT_MODEL=openai/gpt-4o
MATERIAL_MODEL=openai/gpt-4o-mini

# AI Gateway Operational Configuration (§28, §29)
AI_PROVIDER=openrouter
AI_TEMPERATURE=0.2
AI_MAX_RETRIES=2
AI_TIMEOUT_MS=30000

# Supabase PostgreSQL & Auth Configuration (§36, §38)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Observability (§41)
SENTRY_DSN=https://your-dsn@sentry.io/project-id

# Asynchronous Background Processing (§24)
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here
